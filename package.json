{
  "name": "mcp-arabic-ms-word",
  "version": "1.1.2",
  "description": "High-precision Arabic Microsoft Word MCP server for docx creation, inspection, RTL styling, text repair, XML decompression & surgery, and template processing",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-arabic-ms-word": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarwanDevSpace/mcp-arabic-ms-word.git"
  },
  "bugs": {
    "url": "https://github.com/MarwanDevSpace/mcp-arabic-ms-word/issues"
  },
  "homepage": "https://github.com/MarwanDevSpace/mcp-arabic-ms-word#readme",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "arabic",
    "ms-word",
    "docx",
    "rtl",
    "typography",
    "text-repair",
    "xml-decompression",
    "xml-surgery",
    "wordmasteragent",
    "glama"
  ],
  "author": "MarwanDevSpace",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "docx": "^9.1.1",
    "docxtemplater": "^3.58.0",
    "fast-xml-parser": "^4.5.3",
    "jszip": "^3.10.1",
    "pizzip": "^3.1.8",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
